{
  "name": "excalidraw-editor-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "An Excalidraw canvas delivered as an MCP App",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-apps",
    "excalidraw",
    "editor",
    "deepseek"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creativedswork/excalidraw-editor-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/creativedswork/excalidraw-editor-mcp/issues"
  },
  "homepage": "https://github.com/creativedswork/excalidraw-editor-mcp#readme",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "excalidraw-editor-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && tsdown && node scripts/embed-fonts.mjs",
    "test": "pnpm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "release:check": "pnpm run typecheck && pnpm test",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tsdown/css": "0.22.14",
    "@types/node": "22.20.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}
